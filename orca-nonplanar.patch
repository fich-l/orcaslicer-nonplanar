+++ b/tests/fff_print/test_nonplanar.cpp
@@ -0,0 +1,552 @@
+// Nonplanar layers: shell provenance, repeat slicing and deposition order.
+// Ported from the PrusaSlicer nonplanar fork.  Meshes are read from
+// NONPLANAR_FIXTURES_DIR (tests/prusaslicer-nonplanar in the project using
+// this port), the flattened Orca A1 mini profiles (machine, process,
+// filament) from NONPLANAR_ORCA_PROFILES_DIR.
+#include <catch2/catch_all.hpp>
+
+#include <cmath>
+#include <cstdlib>
+#include <map>
+#include <sstream>
+#include <tuple>
+
+#include <boost/filesystem.hpp>
+
+#include "libslic3r/Model.hpp"
+#include "libslic3r/Print.hpp"
+#include "libslic3r/PrintConfig.hpp"
+#include "libslic3r/TriangleMesh.hpp"
+
+#include "test_data.hpp"
+
+using namespace Slic3r;
+
+namespace {
+
+std::string path_in(const char *env, const std::string &name)
+{
+    const char *dir = std::getenv(env);
+    INFO(env);
+    REQUIRE(dir != nullptr);
+    const std::string path = std::string(dir) + "/" + name;
+    INFO(path);
+    REQUIRE(boost::filesystem::exists(path));
+    return path;
+}
+
+std::string fixture(const std::string &name) { return path_in("NONPLANAR_FIXTURES_DIR", name); }
+
+DynamicPrintConfig a1_mini_config()
+{
+    DynamicPrintConfig config = DynamicPrintConfig::full_print_config();
+    for (const char *name : { "machine.json", "filament.json", "process-np.json" }) {
+        DynamicPrintConfig loaded;
+        std::map<std::string, std::string> key_values;
+        std::string reason;
+        loaded.load_from_json(path_in("NONPLANAR_ORCA_PROFILES_DIR", name), ForwardCompatibilitySubstitutionRule::Enable, key_values, reason);
+        INFO(name << ": " << reason);
+        REQUIRE(reason.empty());
+        config.apply(loaded, true);
+    }
+    return config;
+}
+
+TriangleMesh load_mesh(const std::string &name)
+{
+    TriangleMesh mesh;
+    REQUIRE(mesh.ReadSTLFile(fixture(name).c_str()));
+    return mesh;
+}
+
+void place(Model &model, Print &print)
+{
+    model.center_instances_around_point({ 90., 90. });
+    for (ModelObject *object : model.objects) {
+        object->ensure_on_bed();
+        print.auto_assign_extruders(object);
+    }
+}
+
+std::string slice_mesh(TriangleMesh &&mesh, const DynamicPrintConfig &config)
+{
+    Model model;
+    Print print;
+    ModelObject *object = model.add_object();
+    object->add_volume(std::move(mesh));
+    object->add_instance();
+    place(model, print);
+    print.apply(model, config);
+    return Test::gcode(print);
+}
+
+// Generation date and time estimates are not part of the toolpath.
+std::string toolpath(const std::string &gcode)
+{
+    std::istringstream in(gcode);
+    std::ostringstream out;
+    for (std::string line; std::getline(in, line);)
+        if (line.rfind("; generated by", 0) != 0 && line.find("estimated printing time") == std::string::npos &&
+            line.find("model printing time") == std::string::npos && line.find("total estimated time") == std::string::npos)
+            out << line << '\n';
+    return out.str();
+}
+
+// X/Y/Z/E words of a G1 line, keeping the previous position for missing axes.
+bool parse_g1(const std::string &line, double &x, double &y, double &z, double &e)
+{
+    if (line.rfind("G1 ", 0) != 0)
+        return false;
+    const std::string code = line.substr(0, line.find(';'));
+    e = 0;
+    std::istringstream words(code.substr(3));
+    for (std::string word; words >> word;) {
+        const double value = std::atof(word.c_str() + 1);
+        switch (word[0]) {
+        case 'X': x = value; break;
+        case 'Y': y = value; break;
+        case 'Z': z = value; break;
+        case 'E': e = value; break;
+        default: break;
+        }
+    }
+    return true;
+}
+
+struct ConformalMove { double x, y, z, length; std::string shell; };
+
+// Deposited conformal moves with their declared shell (surface, offset).
+std::vector<ConformalMove> conformal_moves(const std::string &gcode)
+{
+    std::vector<ConformalMove> out;
+    std::istringstream in(gcode);
+    double x = 0, y = 0, z = 0, e = 0;
+    bool conformal = false;
+    std::string shell;
+    for (std::string line; std::getline(in, line);) {
+        if (line.rfind(";PATH_TASK ", 0) == 0) {
+            conformal = line.find(" conformal=1") != std::string::npos;
+            const size_t s = line.find(" surface=");
+            shell = s == std::string::npos ? std::string() : line.substr(s + 1);
+            const size_t sl = shell.find(" source_layer=");
+            const size_t so = shell.find(" shell_offset=");
+            if (sl != std::string::npos && so != std::string::npos)
+                shell = shell.substr(0, sl) + shell.substr(so);
+            continue;
+        }
+        const double px = x, py = y, pz = z;
+        if (! parse_g1(line, x, y, z, e))
+            continue;
+        // The profile uses relative E; a positive E is deposition.
+        if (conformal && e > 0)
+            out.push_back({ x, y, z, std::sqrt((x-px)*(x-px) + (y-py)*(y-py) + (z-pz)*(z-pz)), shell });
+    }
+    return out;
+}
+
+size_t shell_count(const std::vector<ConformalMove> &moves)
+{
+    std::map<std::string, size_t> counts;
+    for (const ConformalMove &m : moves)
+        ++ counts[m.shell];
+    return counts.size();
+}
+
+// Extruded length per extrusion role (; FEATURE:) of deposited moves.
+std::map<std::string, double> extruded_length(const std::string &gcode)
+{
+    std::map<std::string, double> out;
+    std::istringstream in(gcode);
+    std::string role;
+    double x = 0, y = 0, z = 0, e = 0;
+    for (std::string line; std::getline(in, line);) {
+        if (line.rfind("; FEATURE: ", 0) == 0) {
+            role = line.substr(11);
+            continue;
+        }
+        const double px = x, py = y, pz = z;
+        if (parse_g1(line, x, y, z, e) && e > 0)
+            out[role] += std::sqrt((x - px) * (x - px) + (y - py) * (y - py) + (z - pz) * (z - pz));
+    }
+    return out;
+}
+
+// Continuous runs of the top shell (offset 0): deposited conformal moves
+// without a travel in between.
+size_t top_shell_runs(const std::string &gcode)
+{
+    std::istringstream in(gcode);
+    bool top = false, in_run = false;
+    size_t runs = 0;
+    for (std::string line; std::getline(in, line);) {
+        if (line.rfind(";PATH_TASK ", 0) == 0) {
+            top = line.find(" conformal=1") != std::string::npos && line.find(" shell_offset=0.000000") != std::string::npos;
+            continue;
+        }
+        if (line.rfind("G1 ", 0) != 0)
+            continue;
+        const std::string code = line.substr(0, line.find(';'));
+        const bool moves = code.find('X') != std::string::npos || code.find('Y') != std::string::npos || code.find('Z') != std::string::npos;
+        const size_t e = code.find(" E");
+        const bool extrudes = e != std::string::npos && std::atof(code.c_str() + e + 2) > 0;
+        if (moves && extrudes && top) {
+            if (! in_run)
+                ++ runs;
+            in_run = true;
+        } else if (moves) {
+            in_run = false;
+        }
+    }
+    return runs;
+}
+
+// Slice with or without the deposition order (NONPLANAR_DEPOSITION_ORDER=0).
+std::string slice_planned(const std::string &name, bool plan)
+{
+    if (plan)
+        unsetenv("NONPLANAR_DEPOSITION_ORDER");
+    else
+        setenv("NONPLANAR_DEPOSITION_ORDER", "0", 1);
+    std::string gcode = slice_mesh(load_mesh(name), a1_mini_config());
+    unsetenv("NONPLANAR_DEPOSITION_ORDER");
+    return gcode;
+}
+
+} // namespace
+
+SCENARIO("Nonplanar shells keep distinct offsets for fills and perimeters", "[Nonplanar]")
+{
+    GIVEN("the 10 degree ramp with three top shells") {
+        const auto moves = conformal_moves(slice_mesh(load_mesh("fixtures/ramp-10deg.stl"), a1_mini_config()));
+        THEN("three shells with offsets 0, 0.2 and 0.4 carry conformal material") {
+            for (const char *offset : { "0.000000", "0.200000", "0.400000" }) {
+                const std::string shell = std::string("shell_offset=") + offset;
+                bool found = false;
+                for (const ConformalMove &m : moves)
+                    found |= m.shell.find(shell) != std::string::npos;
+                INFO("shell " << offset);
+                REQUIRE(found);
+            }
+        }
+    }
+}
+
+SCENARIO("Nonplanar shells slice with Orca's overhang detection and wall generators", "[Nonplanar]")
+{
+    // Nonplanar shells have no planar layer below them; Orca's overhang
+    // detection must not run on them (crashed the GUI with detect_overhang_wall).
+    for (const char *generator : { "classic", "arachne" }) {
+        GIVEN(std::string("the 10 degree ramp, detect_overhang_wall on, ") + generator + " walls") {
+            DynamicPrintConfig config = a1_mini_config();
+            config.set_deserialize_strict({ { "detect_overhang_wall", "1" }, { "wall_generator", generator } });
+            const auto moves = conformal_moves(slice_mesh(load_mesh("fixtures/ramp-10deg.stl"), config));
+            THEN("the three conformal shells are printed") {
+                REQUIRE(shell_count(moves) == 3);
+            }
+        }
+    }
+}
+
+SCENARIO("Repeated slicing after a parameter change matches a fresh slice", "[Nonplanar]")
+{
+    const DynamicPrintConfig base = a1_mini_config();
+    // (option, temporary value): each covers a different invalidation step.
+    const std::vector<std::pair<std::string, std::string>> changes {
+        { "sparse_infill_density", "25%" }, // posPrepareInfill / posInfill
+        { "wall_loops", "4" },              // posPerimeters
+        { "top_shell_layers", "4" },        // number of conformal shells
+        { "nonplanar_layers_angle", "11" }, // posSlice
+    };
+    for (const auto &[key, value] : changes) {
+        GIVEN("the 2D wave, changed " + key + " and changed back") {
+            Model model;
+            Print print;
+            ModelObject *object = model.add_object();
+            object->add_volume(load_mesh("fixtures/wave-2d-10deg.stl"));
+            object->add_instance();
+            place(model, print);
+            print.apply(model, base);
+            const std::string fresh = toolpath(Test::gcode(print));
+
+            DynamicPrintConfig changed = base;
+            changed.set_deserialize_strict(key, value);
+            print.apply(model, changed);
+            const std::string intermediate = toolpath(Test::gcode(print));
+            print.apply(model, base);
+            const std::string repeated = toolpath(Test::gcode(print));
+
+            THEN("the intermediate slice differs and the repeated slice equals the fresh one") {
+                INFO("changed option " << key << "=" << value);
+                REQUIRE(intermediate != fresh);
+                REQUIRE(conformal_moves(repeated).size() == conformal_moves(fresh).size());
+                REQUIRE(repeated == fresh);
+            }
+        }
+    }
+}
+
+SCENARIO("Target surfaces use the same transformation as slicing", "[Nonplanar]")
+{
+    const DynamicPrintConfig config = a1_mini_config();
+    const Vec3d rotation(0., 0., PI / 6.);
+    const Vec3d scaling(1.1, 1.1, 1.1);
+
+    auto slice_with = [&config](TriangleMesh &&mesh, const Vec3d &rotation, const Vec3d &scaling) {
+        Model model;
+        Print print;
+        ModelObject *object = model.add_object();
+        object->add_volume(std::move(mesh));
+        ModelInstance *instance = object->add_instance();
+        instance->set_rotation(rotation);
+        instance->set_scaling_factor(scaling);
+        place(model, print);
+        print.apply(model, config);
+        return Test::gcode(print);
+    };
+
+    GIVEN("the 2D wave rotated and scaled in the project, and the same mesh transformed beforehand") {
+        TriangleMesh pre = load_mesh("fixtures/wave-2d-10deg.stl");
+        Transform3d trafo = Transform3d::Identity();
+        trafo.rotate(Eigen::AngleAxisd(rotation.z(), Vec3d::UnitZ()));
+        trafo.scale(scaling);
+        pre.transform(trafo, true);
+        const auto in_project = conformal_moves(slice_with(load_mesh("fixtures/wave-2d-10deg.stl"), rotation, scaling));
+        const auto transformed = conformal_moves(slice_with(std::move(pre), Vec3d::Zero(), Vec3d::Ones()));
+        THEN("both give the same conformal shells") {
+            // Pre-transforming the mesh rounds its vertices to float, so a
+            // few segment splits may differ.  The shells, their length and
+            // their height range must not.
+            struct Shell { double length = 0, zmin = 1e9, zmax = -1e9; };
+            auto summarize = [](const std::vector<ConformalMove> &moves) {
+                std::map<std::string, Shell> out;
+                for (const ConformalMove &m : moves) {
+                    Shell &s = out[m.shell];
+                    s.length += m.length;
+                    s.zmin = std::min(s.zmin, m.z);
+                    s.zmax = std::max(s.zmax, m.z);
+                }
+                return out;
+            };
+            REQUIRE(! transformed.empty());
+            REQUIRE(shell_count(in_project) == 3);
+            const auto a = summarize(in_project), b = summarize(transformed);
+            REQUIRE(a.size() == b.size());
+            for (const auto &[shell, sa] : a) {
+                REQUIRE(b.count(shell) == 1);
+                const Shell &sb = b.at(shell);
+                INFO(shell << " length " << sa.length << " vs " << sb.length << ", z " << sa.zmin << ".." << sa.zmax
+                           << " vs " << sb.zmin << ".." << sb.zmax);
+                REQUIRE(std::abs(sa.length - sb.length) <= 0.005 * sb.length);
+                REQUIRE(std::abs(sa.zmin - sb.zmin) <= 0.005);
+                REQUIRE(std::abs(sa.zmax - sb.zmax) <= 0.005);
+            }
+        }
+    }
+}
+
+SCENARIO("Target surfaces of every volume are kept", "[Nonplanar]")
+{
+    GIVEN("one object with two separate ramp volumes") {
+        Model model;
+        Print print;
+        ModelObject *object = model.add_object();
+        ModelVolume *left = object->add_volume(load_mesh("fixtures/ramp-10deg.stl"));
+        ModelVolume *right = object->add_volume(load_mesh("fixtures/ramp-10deg.stl"));
+        const BoundingBoxf3 box = left->mesh().bounding_box();
+        right->set_offset(Vec3d(box.size().x() + 10., 0., 0.));
+        object->add_instance();
+        place(model, print);
+        print.apply(model, a1_mini_config());
+        const auto moves = conformal_moves(Test::gcode(print));
+        THEN("conformal shells are printed on both volumes") {
+            REQUIRE(shell_count(moves) == 6);
+        }
+    }
+}
+
+SCENARIO("The deposition order moves material but never loses or doubles it", "[Nonplanar]")
+{
+    GIVEN("the mixed-slope Triangle, which needs cross-layer reordering") {
+        const std::string planned   = slice_planned("fixtures/triangle-mixed-slope-tessellated.stl", true);
+        const std::string unplanned = slice_planned("fixtures/triangle-mixed-slope-tessellated.stl", false);
+        THEN("material is deferred, and every role keeps its extruded length") {
+            REQUIRE(planned.find(";PATH_DEFERRED") != std::string::npos);
+            REQUIRE(unplanned.find(";PATH_DEFERRED") == std::string::npos);
+            const auto a = extruded_length(planned), b = extruded_length(unplanned);
+            REQUIRE(a.size() == b.size());
+            for (const auto &[role, length] : b) {
+                INFO(role << ": planned " << (a.count(role) ? a.at(role) : -1.) << " unplanned " << length);
+                REQUIRE(a.count(role) == 1);
+                // Cutting a path only removes coincident end points.
+                REQUIRE(std::abs(a.at(role) - length) <= 0.001 * length + 0.05);
+            }
+        }
+    }
+}
+
+SCENARIO("The deposition order never cuts the top shell", "[Nonplanar]")
+{
+    for (const char *name : { "fixtures/triangle-mixed-slope-tessellated.stl", "fixtures/wave-2d-10deg.stl" }) {
+        GIVEN(std::string("the model ") + name) {
+            const size_t planned = top_shell_runs(slice_planned(name, true));
+            const size_t unplanned = top_shell_runs(slice_planned(name, false));
+            THEN("the top shell has as many continuous runs as without the plan") {
+                INFO("planned " << planned << ", unplanned " << unplanned);
+                REQUIRE(unplanned > 0);
+                REQUIRE(planned == unplanned);
+            }
+        }
+    }
+}
+
+// Extrusion per mm of deposited moves, grouped by (role, conformal shell
+// offset or "planar").
+static std::map<std::pair<std::string, std::string>, double> extrusion_per_mm(const std::string &gcode)
+{
+    std::map<std::pair<std::string, std::string>, std::pair<double, double>> sums;
+    std::istringstream in(gcode);
+    std::string role, shell = "planar";
+    double x = 0, y = 0, z = 0, e = 0;
+    for (std::string line; std::getline(in, line);) {
+        // Orca writes "; FEATURE: " for Bambu printers and ";TYPE:" otherwise;
+        // which one depends on a global set by the last processed print.
+        if (line.rfind("; FEATURE: ", 0) == 0 || line.rfind(";TYPE:", 0) == 0) {
+            role = line.substr(line[1] == ' ' ? 11 : 6);
+            continue;
+        }
+        if (line.rfind(";PATH_TASK ", 0) == 0) {
+            const size_t so = line.find(" shell_offset=");
+            shell = line.find(" conformal=1") != std::string::npos && so != std::string::npos ? line.substr(so + 14) : "planar";
+            continue;
+        }
+        const double px = x, py = y, pz = z;
+        if (parse_g1(line, x, y, z, e) && e > 0) {
+            auto &[length, extruded] = sums[{ role, shell }];
+            length   += std::sqrt((x - px) * (x - px) + (y - py) * (y - py) + (z - pz) * (z - pz));
+            extruded += e;
+        }
+    }
+    std::map<std::pair<std::string, std::string>, double> out;
+    for (const auto &[key, value] : sums)
+        if (value.first > 1.)
+            out[key] = value.second / value.first;
+    return out;
+}
+
+SCENARIO("The nonplanar top surface flow ratio applies to the conformal top surface only", "[Nonplanar]")
+{
+    GIVEN("the 10 degree ramp with and without a nonplanar top surface flow ratio of 1.2") {
+        const DynamicPrintConfig base = a1_mini_config();
+        DynamicPrintConfig changed = base;
+        changed.set_deserialize_strict({ { "set_nonplanar_top_surface_flow_ratio", "1" }, { "nonplanar_top_surface_flow_ratio", "1.2" } });
+        const auto a = extrusion_per_mm(slice_mesh(load_mesh("fixtures/ramp-10deg.stl"), base));
+        const auto b = extrusion_per_mm(slice_mesh(load_mesh("fixtures/ramp-10deg.stl"), changed));
+        THEN("conformal top surface lines get 1.2 times the flow, all other lines keep theirs") {
+            const std::pair<std::string, std::string> top { "Top surface", "0.000000" };
+            REQUIRE(a.count(top) == 1);
+            REQUIRE(b.count(top) == 1);
+            REQUIRE(std::abs(b.at(top) / a.at(top) - 1.2) < 0.01);
+            bool planar_top = false;
+            for (const auto &[key, value] : a) {
+                if (key == top)
+                    continue;
+                planar_top |= key.first == "Top surface" && key.second == "planar";
+                INFO(key.first << " / " << key.second << ": " << value << " vs " << (b.count(key) ? b.at(key) : -1.));
+                REQUIRE(b.count(key) == 1);
+                REQUIRE(std::abs(b.at(key) / value - 1.) < 0.01);
+            }
+            REQUIRE(planar_top);
+        }
+    }
+}
+
+// Dominant XY direction (0..180 degrees, 5 degree bins, weighted by length)
+// of deposited conformal infill moves of one shell offset.
+static int dominant_direction(const std::string &gcode, const std::string &offset)
+{
+    std::map<int, double> bins;
+    std::istringstream in(gcode);
+    std::string role, shell;
+    bool conformal = false;
+    double x = 0, y = 0, z = 0, e = 0;
+    for (std::string line; std::getline(in, line);) {
+        if (line.rfind("; FEATURE: ", 0) == 0) {
+            role = line.substr(11);
+            continue;
+        }
+        if (line.rfind(";PATH_TASK ", 0) == 0) {
+            conformal = line.find(" conformal=1") != std::string::npos;
+            const size_t so = line.find(" shell_offset=");
+            shell = so == std::string::npos ? std::string() : line.substr(so + 14);
+            continue;
+        }
+        const double px = x, py = y;
+        if (! parse_g1(line, x, y, z, e) || e <= 0 || ! conformal || shell != offset || role.find("wall") != std::string::npos)
+            continue;
+        const double length = std::hypot(x - px, y - py);
+        if (length < 1.)
+            continue;
+        double angle = std::atan2(y - py, x - px) * 180. / M_PI;
+        angle = std::fmod(angle + 360., 180.);
+        bins[int(std::lround(angle / 5.)) * 5 % 180] += length;
+    }
+    REQUIRE(! bins.empty());
+    return std::max_element(bins.begin(), bins.end(), [](const auto &a, const auto &b) { return a.second < b.second; })->first;
+}
+
+SCENARIO("The nonplanar top surface direction sets the top shell lines, the shells below cross them", "[Nonplanar]")
+{
+    GIVEN("the 10 degree ramp with a nonplanar top surface direction of 0 and of 90 degrees") {
+        auto slice = [](const char *direction) {
+            DynamicPrintConfig config = a1_mini_config();
+            config.set_deserialize_strict({ { "set_nonplanar_top_surface_direction", "1" }, { "nonplanar_top_surface_direction", direction } });
+            return slice_mesh(load_mesh("fixtures/ramp-10deg.stl"), config);
+        };
+        const std::string a = slice("0"), b = slice("90");
+        THEN("the top shell turns by 90 degrees, and the shell below lies across the top shell") {
+            const int top_a = dominant_direction(a, "0.000000"), top_b = dominant_direction(b, "0.000000");
+            const int below_a = dominant_direction(a, "0.200000"), below_b = dominant_direction(b, "0.200000");
+            INFO("top " << top_a << " / " << top_b << ", below " << below_a << " / " << below_b);
+            REQUIRE((top_a - top_b + 180) % 180 == 90);
+            REQUIRE((top_a - below_a + 180) % 180 == 90);
+            REQUIRE((top_b - below_b + 180) % 180 == 90);
+        }
+    }
+}
+
+// Extruded XY length of support moves (roles starting with "Support").
+static double support_length(const std::string &gcode)
+{
+    std::istringstream in(gcode);
+    std::string role;
+    double x = 0, y = 0, z = 0, e = 0, length = 0;
+    for (std::string line; std::getline(in, line);) {
+        if (line.rfind("; FEATURE: ", 0) == 0) {
+            role = line.substr(11);
+            continue;
+        }
+        const double px = x, py = y;
+        if (parse_g1(line, x, y, z, e) && e > 0 && role.rfind("Support", 0) == 0)
+            length += std::hypot(x - px, y - py);
+    }
+    return length;
+}
+
+SCENARIO("Support sees the object before the conformal shells were moved", "[Nonplanar]")
+{
+    GIVEN("a part needing support, sliced with support with and without nonplanar layers") {
+        auto slice = [](const char *nonplanar) {
+            DynamicPrintConfig config = a1_mini_config();
+            config.set_deserialize_strict({ { "enable_support", "1" }, { "use_nonplanar_layers", nonplanar } });
+            TriangleMesh mesh;
+            REQUIRE(mesh.ReadSTLFile(path_in("NONPLANAR_ORCA_PROFILES_DIR", "../fixtures/support-issue.stl").c_str()));
+            return slice_mesh(std::move(mesh), config);
+        };
+        const double planar = support_length(slice("0")), nonplanar = support_length(slice("1"));
+        THEN("the support is the same; supports under moved shell strips would add support inside the part") {
+            INFO("support planar " << planar << " mm, nonplanar " << nonplanar << " mm");
+            REQUIRE(planar > 100.);
+            REQUIRE(std::abs(nonplanar - planar) <= 0.02 * planar);
+        }
+    }
+}
