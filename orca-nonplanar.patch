+namespace Slic3r {
+
+class PrintObject;
+
+// Cross-layer deposition order for one PrintObject with conformal shells.
+//
+// Units are never cut: a conformal shell is printed as a whole, in the order
+// of the unplanned export, and planar material moves as whole wall loops or
+// paths.
+// Material that would obstruct the tool at a later task is deferred: it is
+// emitted at its own height after that task.  Time is a slot, 2 * layer for
+// the regular material of a layer and 2 * layer + 1 for deferred material
+// emitted at the end of that layer, in ascending order of its regular slot
+// ("base"; home layer for conformal material).  Material with equal slot and
+// base is treated as unordered.  Planar and conformal material are deferred
+// alike, so the lower part of a non-convex target surface can receive all its
+// shells before a higher part obstructs it.  The plan is closed under two
+// dependencies: material resting on deferred material is deferred with it
+// (support), and material that would obstruct deferred material must not be
+// printed before it (access).  Both point upwards, so the closure always
+// terminates; slots beyond the last layer are emitted after it in order.
+struct NonplanarDeferral
+{
+    // Slot of one planned path.  A path is identified by its source path id,
+    // its end points and their neighbours (it may be emitted reversed; a
+    // closed path has equal end points).
+    struct PathPlan {
+        Point  first, second, before_last, last;
+        double length;
+        // From arc length breaks[k].first (scaled, from `first`) the path is
+        // emitted in slot breaks[k].second.  More than one entry only for a
+        // wall loop that had to be cut; never for a conformal shell.
+        std::vector<std::pair<double, int>> breaks;
+    };
+    // Per layer index (home layer for conformal paths) and source path id.
+    std::vector<std::map<size_t, std::vector<PathPlan>>> layers;
+    size_t conformal_samples { 0 };
+    size_t planar_samples    { 0 };
+    size_t deferred_samples  { 0 };
+    size_t deferred_paths    { 0 };
+    size_t cut_paths         { 0 };
+    size_t refined_units     { 0 };
+    // Paths before their regular slot; the plan never produces any.
+    size_t advanced_paths    { 0 };
+
+    bool empty() const { return deferred_paths == 0 && advanced_paths == 0; }
+    // Plan of a path piece, or nullptr; `reversed` if the piece runs backwards.
+    const PathPlan* find(size_t layer_id, size_t source_path_id, const Polyline3 &polyline, bool &reversed) const;
+};
+
+struct NonplanarClearanceModel
+{
+    // Simplified A1 mini hotend (profiles/a1-mini-simplified.json, generated by
+    // scripts/make-a1-mini-simplified-profile.py from input/A1 Mini/Simplified
+    // Hotend v1.1.step, user 2026-10-29; replaces the detailed measured hotend).  Values include the profile's clearance and
+    // uncertainty; heights are above the nozzle tip, offsets in the printer
+    // frame relative to the nozzle.  Material higher than the tool by more
+    // than a component's underside obstructs within its footprint (plus the
+    // bead half width + 0.02 mm, as in the final check).  The first ring is
+    // the flat tip with the process-contact allowance, which the final
+    // check grants to extrusions and vertical moves; the G-code emitter
+    // reaches every changed height by a lift and a vertical descent.
+    struct Ring { double bottom, radius; };
+    struct Box  { double bottom, x_min, x_max, y_min, y_max; };
+    // Flat tip with the process-contact allowance, and the cone from
+    // 0.15 mm to the heater block, sliced like the final check (widest radius
+    // at the lowest height of each slice), inflated by clearance and
+    // measurement uncertainty (0.01 + 0.01 mm, accepted by the user).
+    double tip_radius_mm         { 0.5504 };
+    double contact_allowance_mm  { 0.12 }; // accepted by the user 2026-10-23
+    double cone_bottom_mm        { 0.15 },  cone_bottom_radius_mm { 0.613 };
+    double cone_top_mm           { 2.5 },   cone_top_radius_mm    { 1.5979 };
+    double cone_inflation_mm     { 0.02 };
+    int    cone_slices           { 24 };
+    std::vector<Ring> rings() const {
+        std::vector<Ring> out { { contact_allowance_mm, tip_radius_mm } };
+        const double step = (cone_top_mm - cone_bottom_mm) / cone_slices;
+        for (int k = 0; k < cone_slices; ++ k) {
+            const double low = cone_bottom_mm + k * step, high = low + step;
+            const double r = cone_bottom_radius_mm + (cone_top_radius_mm - cone_bottom_radius_mm) * (high - cone_bottom_mm) / (cone_top_mm - cone_bottom_mm);
+            out.push_back({ low - cone_inflation_mm, r + cone_inflation_mm });
+        }
+        return out;
+    }
+    // Block: truncated pyramid (12 degree flanks) from 2.5 to 7.5 mm in
+    // 0.3-mm bands.  Everything above the block counts as a collision (user,
+    // 2026-10-29): its top footprint continues upwards.
+    std::vector<Box> boxes {
+        {  2.3500,  -7.0379,   7.0379,  -9.4243,   9.4243 }, // block 2.5-2.8
+        {  2.6500,  -8.4493,   8.4493, -10.8357,  10.8357 }, // block 2.8-3.1
+        {  2.9500,  -9.8606,   9.8606, -12.2470,  12.2470 }, // block 3.1-3.4
+        {  3.2500, -11.2720,  11.2720, -13.6584,  13.6584 }, // block 3.4-3.7
+        {  3.5500, -12.6834,  12.6834, -15.0698,  15.0698 }, // block 3.7-4.0
+        {  3.8500, -14.0948,  14.0948, -16.4812,  16.4812 }, // block 4.0-4.3
+        {  4.1500, -15.5062,  15.5062, -17.8926,  17.8926 }, // block 4.3-4.6
+        {  4.4500, -16.9176,  16.9176, -19.3040,  19.3040 }, // block 4.6-4.9
+        {  4.7500, -18.3290,  18.3290, -20.7154,  20.7154 }, // block 4.9-5.2
+        {  5.0500, -19.7404,  19.7404, -22.1268,  22.1268 }, // block 5.2-5.5
+        {  5.3500, -21.1518,  21.1518, -23.5382,  23.5382 }, // block 5.5-5.8
+        {  5.6500, -22.5631,  22.5631, -24.9495,  24.9495 }, // block 5.8-6.1
+        {  5.9500, -23.9745,  23.9745, -26.3609,  26.3609 }, // block 6.1-6.4
+        {  6.2500, -25.3859,  25.3859, -27.7723,  27.7723 }, // block 6.4-6.7
+        {  6.5500, -26.7973,  26.7973, -29.1837,  29.1837 }, // block 6.7-7.0
+        {  6.8500, -28.2087,  28.2087, -30.5951,  30.5951 }, // block 7.0-7.3
+        {  7.1500, -29.1496,  29.1496, -31.5360,  31.5360 }, // block 7.3-7.5
+        {  7.2000, -29.2996,  29.2996, -31.6860,  31.6860 }, // above model
+    };
+    double safety_mm     { 0.03 };
+    double bead_margin   { 0.02 };
+    double sample_step   { 0.1 };
+};
+
+// Throws Slic3r::SlicingError if no admissible order exists.
+NonplanarDeferral plan_nonplanar_deferral(const PrintObject &object, const NonplanarClearanceModel &model);
+
+// Heights of the material deposited so far, in G-code XY coordinates, for
+// the height of lifted travels.  Three aligned grids (0.25, 0.5 and 2 mm
+// cells) hold the highest material touching a cell: the fine one for the
+// tip and cone, the others for the heater block and the toolhead body.
+// A cell is marked if its centre lies within the bead radius plus half the
+// cell diagonal of a deposited segment, so every deposited point lies in a
+// marked cell of each grid.
+class NonplanarHeightMap
+{
+public:
+    void   clear();
+    // Segment a-b of a bead with the given half width, highest point z.
+    void   deposit(const Vec2d &a, const Vec2d &b, double z, double half_width);
+    // Lowest tool height for a horizontal travel along `path` that keeps the
+    // model's components (tip without contact allowance) clear of all
+    // deposited material by the model's safety margin; at least `min_z`.
+    double travel_height(const std::vector<Vec2d> &path, const NonplanarClearanceModel &model, double min_z) const;
+
+private:
+    struct Grid {
+        double             cell { 0. };
+        int                n    { 0 };
+        std::vector<float> h;
+        bool  index(double x, double y, int &ix, int &iy) const;
+        float at(int ix, int iy) const { return h[size_t(iy) * size_t(n) + size_t(ix)]; }
+    };
+    void   allocate();
+    double max_in_rect(const Grid &grid, double x0, double y0, double x1, double y1) const;
+
+    static constexpr double origin = -40.;
+    static constexpr double extent = 280.;
+    Grid   m_fine, m_mid, m_coarse;
+    double m_max_z { -1e9 };
+};
+
+} // namespace Slic3r
+
+#endif // slic3r_NonplanarSchedule_hpp_
