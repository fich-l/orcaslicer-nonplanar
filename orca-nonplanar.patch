+void fuzzy_top_surface_heights(Points3& pts, const PrintRegionConfig& config, const int layer_id, const coordf_t slice_z)
+{
+    if (!config.fuzzy_skin_top_surface || pts.size() < 2 || (layer_id <= 0 && !config.fuzzy_skin_first_layer))
+        return;
+    FuzzySkinConfig cfg{FuzzySkinType::All,
+                        scaled<coord_t>(config.fuzzy_skin_thickness.value),
+                        scaled<coord_t>(config.fuzzy_skin_point_distance.value),
+                        config.fuzzy_skin_first_layer,
+                        config.fuzzy_skin_noise_type,
+                        config.fuzzy_skin_scale,
+                        config.fuzzy_skin_octaves,
+                        config.fuzzy_skin_persistence,
+                        FuzzySkinMode::Displacement,
+                        config.fuzzy_skin_ripples_per_layer,
+                        config.fuzzy_skin_ripple_offset,
+                        config.fuzzy_skin_layers_between_ripple_offset,
+                        layer_id};
+    // Ripples follow a wall loop; on a top line the classic random noise is used instead.
+    if (cfg.noise_type == NoiseType::Ripple)
+        cfg.noise_type = NoiseType::Classic;
+    std::unique_ptr<noise::module::Module> noise = get_noise_module(cfg);
+    const double thickness = unscale<double>(cfg.thickness);
+
+    // New points along each segment (heights interpolated: a conformal segment lies on one facet). The original
+    // points keep their height. New points stay >= 0.1 mm apart and from the original points, and segments shorter
+    // than that or steeper than 11 deg get none, so the 0.001-mm G-code rounding cannot break the 12-deg check.
+    const double max_gradient = std::tan(11. * M_PI / 180.);
+    const double min_gap  = scaled<double>(0.1);
+    const double min_dist = std::max(min_gap, cfg.point_distance * 3. / 4.);
+    const double range    = cfg.point_distance / 2.;
+    Points3             dense{pts.front()};
+    std::vector<double> off{0.};
+    double              left_over = random_value() * (min_dist / 2.);
+    for (size_t i = 1; i < pts.size(); ++i) {
+        const Vec3d  a = pts[i - 1].cast<double>(), b = pts[i].cast<double>();
+        const double len = (b - a).head<2>().norm();
+        double       d   = std::max(left_over, min_gap);
+        if (len < 2. * min_gap || std::abs(b.z() - a.z()) > max_gradient * len)
+            d = len;
+        for (; d < len - min_gap; d += min_dist + random_value() * range) {
+            const Vec3d q = a + (b - a) * (d / len);
+            dense.emplace_back(Point3(q.cast<coord_t>()));
+            const double v = std::clamp(noise->GetValue(unscale_(q.x()), unscale_(q.y()), slice_z), -1., 1.);
+            off.push_back(0.5 * (v + 1.) * thickness);
+        }
+        left_over = std::max(0., d - len);
+        if (dense.back() != pts[i]) {
+            dense.push_back(pts[i]);
+            off.push_back(0.);
+        }
+    }
+    off.back() = 0.;
+    // Limit the height changes: forward pass bounds the rise, backward pass the fall of every move. The base line
+    // keeps max(tan(11 deg), its own slope), so the raised offsets stay >= 0 and the ends stay at 0.
+    const size_t n = dense.size();
+    std::vector<double> allowed(n - 1), dz(n - 1);
+    for (size_t i = 0; i + 1 < n; ++i) {
+        const double dxy = unscale<double>((dense[i + 1] - dense[i]).head<2>().cast<double>().norm());
+        dz[i]      = unscale<double>(dense[i + 1].z() - dense[i].z());
+        allowed[i] = std::max(max_gradient * dxy, std::abs(dz[i]));
+    }
+    for (size_t i = 1; i < n; ++i)
+        off[i] = std::min(off[i], off[i - 1] + allowed[i - 1] - dz[i - 1]);
+    for (size_t i = n - 1; i > 0; --i)
+        off[i - 1] = std::min(off[i - 1], off[i] + allowed[i - 1] + dz[i - 1]);
+    for (size_t i = 0; i < n; ++i)
+        dense[i].z() += coord_t(std::lround(scale_(std::max(0., off[i]))));
+    pts = std::move(dense);
+}
