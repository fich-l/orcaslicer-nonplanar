+// Nonplanar: two-operand clipping with Clipper2, whose hole nesting stays correct with
+// thousands of touching pieces (Clipper 1 can hang a hole on the wrong outer contour there).
+static ExPolygons clip_ex_2(Clipper2Lib::ClipType ct, const Polygons &subject, const Polygons &clip)
+{
+    Clipper2Lib::Clipper64 c;
+    c.AddSubject(Slic3rPolygons_to_Paths64(subject));
+    if (! clip.empty())
+        c.AddClip(Slic3rPolygons_to_Paths64(clip));
+    Clipper2Lib::PolyTree64 solution;
+    c.Execute(ct, Clipper2Lib::FillRule::NonZero, solution);
+    return PolyTreeToExPolygons(std::move(solution));
+}
+ExPolygons intersection_ex_2(const Polygons &subject, const Polygons &clip) { return clip_ex_2(Clipper2Lib::ClipType::Intersection, subject, clip); }
+ExPolygons diff_ex_2(const Polygons &subject, const Polygons &clip) { return clip_ex_2(Clipper2Lib::ClipType::Difference, subject, clip); }
+
 ExPolygons union_ex_2(const Polygons& polygons)
 {
     Clipper2Lib::Clipper64 c;
